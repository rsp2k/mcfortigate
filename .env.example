# Copy to .env and fill in. Never commit the real file.
#
# An API token is preferred over a username and password. Create one on the
# FortiGate under System > Administrators > Create New > REST API Admin, give
# it a read-only profile, and restrict it to the source address of whatever
# host runs this server.

# --- Single appliance -------------------------------------------------------
FORTIGATE_HOST=fgt.example.com
FORTIGATE_TOKEN=replace-me

# Optional. The alias tools use for this appliance. Defaults to the host.
# FORTIGATE_NAME=edge

# Optional. Defaults shown.
# FORTIGATE_VDOM=root
# FORTIGATE_VERIFY_SSL=true
# FORTIGATE_TIMEOUT=30
# FORTIGATE_PORT=443

# Legacy auth, used only when no token is set.
# FORTIGATE_USERNAME=readonly
# FORTIGATE_PASSWORD=replace-me

# --- Several appliances -----------------------------------------------------
# Aliases become the `target` argument on every tool, so keep them short.
# Overrides and single-appliance settings above can coexist with this.
#
# FORTIGATE_TARGETS='{
#   "edge":   {"host": "fgt-edge1.example.com", "token": "replace-me"},
#   "branch": {"host": "fgt-br2.example.com", "token": "replace-me", "verify_ssl": false}
# }'
